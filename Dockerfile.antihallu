FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

WORKDIR /app

RUN pip install --no-cache-dir \
    transformers==4.57.1 \
    accelerate \
    fastapi \
    uvicorn \
    scikit-learn \
    scipy \
    tqdm

COPY antihallu/server.py antihallu/medgemma_detector.py /app/
COPY antihallu/examples.json antihallu/cache.json /app/
COPY antihallu/calibration/ /app/calibration/

EXPOSE 8000

CMD ["python", "server.py"]
